{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "printWidth": 100,
  "sortTailwindcss": {},
  "sortPackageJson": false,
  "ignorePatterns": ["auto-imports.d.ts", "*.txt", "app/data/generated/*.json"]
}
